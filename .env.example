# Copy to .env for local runs. In GitHub Actions these are set as
# repo Secrets/Variables instead (see .github/workflows/monitor.yml).

# --- Target -------------------------------------------------------------------
AMC_THEATRE_URL=https://www.amctheatres.com/movie-theatres/new-york-city/amc-lincoln-square-13/showtimes
# Limit how many upcoming dates to check (AMC exposes ~130). Blank = all.
AMC_MAX_DATES=

# --- Proxy (residential, sticky session) -------------------------------------
# cf_clearance is IP-bound, so use a STICKY session (stable IP per browser).
# {session} is replaced with a fresh id each cycle so the IP rotates over time.
# One URL = one IP/browser. Comma-separate several for parallel IPs.
# Example (format varies by provider):
#   AMC_PROXIES=http://USER-session-{session}:PASS@gate.smartproxy.com:7000
AMC_PROXIES=

# --- State (Turso / libSQL) ---------------------------------------------------
# Local dev can omit these (defaults to file:seen.db). Cloud needs both.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- SMS (Twilio) -------------------------------------------------------------
# Leave blank to dry-run (alerts print to the log instead of texting).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
TWILIO_TO=+1XXXXXXXXXX

# --- Tuning (optional) --------------------------------------------------------
AMC_CONCURRENCY=3
AMC_BATCH_SIZE=9
AMC_HEADLESS=true
